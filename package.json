{
  "name": "ensenas",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "eas-build-pre-install": "node .eas/build/switch-env.js",
    "start": "node .eas/build/switch-env.js learner && expo start",
    "start:studio": "node .eas/build/switch-env.js studio && expo start",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:learner": "eas build --profile preview-learner --platform android",
    "build:studio": "eas build --profile preview-studio --platform android"
  },
